{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firaw SSH",
  "mainBinaryName": "FirawSSH",
  "version": "0.4.1",
  "identifier": "br.com.firawynix.ssh",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5187",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Firaw SSH",
      "width": 1420,
      "height": 900,
      "minWidth": 1050,
      "minHeight": 690,
      "resizable": true,
      "decorations": false,
      "center": true,
      "backgroundColor": "#080d16"
    }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Firawynix",
    "copyright": "Firawynix",
    "shortDescription": "SSH, SFTP e túneis sem complicação",
    "longDescription": "Cliente SSH para Windows e Linux com múltiplos perfis, cofre de credenciais, terminal guiado e SFTP.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"], "displayLanguageSelector": false },
      "signCommand": {
        "cmd": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "../tools/sign-windows.ps1", "%1"]
      }
    }
  }
}
